{
  "manifest_version": 3,
  "name": "Domain Scanner",
  "version": "1.0.2",
  "description": "Scan a domain for registration, DNS records, redirects, and hosting details.",
  "homepage_url": "https://byteobsidian.github.io/Domain-Scanner/",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Domain Scanner",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["webRequest", "storage"],
  "host_permissions": ["<all_urls>"]
}
